# Chave da APICPF. Usada somente pela função serverless /api/cpf.
# Na Vercel, cadastre esta variável em Project Settings > Environment Variables.
APICPF_API_KEY=

# --- Proteções do próprio /api/cpf (api/cpf.js) ---
# Origens extras aceitas na checagem de cabeçalho Origin/Referer, separado por
# vírgula. O host do próprio deploy já é aceito automaticamente; use isto para
# URLs de preview fixas ou outro domínio. Vazio = só o host da requisição.
# Ex.: SCIPIONE_ALLOWED_ORIGINS=scipione.vercel.app,meudominio.com.br
SCIPIONE_ALLOWED_ORIGINS=

# Cota por janela fixa, contada em memória de cada instância aquecida (não é
# limite distribuído: o teto real de custo é a regra de rate limit da WAF).
# Janela em milissegundos (padrão 60000 = 1 minuto).
CPF_QUOTA_WINDOW_MS=
# Requisições por IP dentro da janela (padrão 30). O app faz 1 chamada por CPF
# consultado e cacheia 30 minutos no navegador, então 30/min não aperta o uso real.
CPF_QUOTA_PER_IP=
# Requisições por instância dentro da janela (padrão 300). É o trava-custos para
# quem rotaciona IP; em caso de bloqueio o /api/cpf devolve 429 com Retry-After.
CPF_QUOTA_PER_INSTANCE=
